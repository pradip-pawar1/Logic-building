			"id": "shape:_jlog5rtFkPqQaqgrNPJT",
			"type": "geo",
			"props": {
				"w": 358,
				"h": 362,
				"geo": "rectangle",
				"dash": "draw",
				"growY": 0,
				"url": "",
				"scale": 1,
				"flipX": false,
				"flipY": false,
				"color": "black",
				"labelColor": "black",
