				"size": "m",
				"font": "draw",
				"align": "middle",
				"verticalAlign": "middle",
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "You are a company that contains so many types of vehicals and allow people/provide service of vehical rental systme."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Based on vehical and use (time) you take money from user/customer."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "a3sSU",
			"typeName": "shape"
		},
		{
			"meta": {},
			"id": "binding:En3GtlxEoKmBLqAoQgS3-",
			"type": "arrow",
			"fromId": "shape:0kM5k3DNKSV385erNmzCh",
			"toId": "shape:lCBj54UhZ3LcVn1mi5JNm",
			"props": {
				"isPrecise": true,
				"isExact": false,
				"normalizedAnchor": {
					"x": 0.5,
					"y": 0
				},
				"snap": "edge-point",
