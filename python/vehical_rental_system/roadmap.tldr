												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Phase 5 — JSON storage"
												}
											]
										},
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Only after the in-memory system works, decide how each object is converted to and restored from data. JSON stores data, not live Python objects."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
