			},
			"typeName": "binding"
		},
		{
			"meta": {},
			"id": "binding:_6sNPcmTZFzx_v4KFaUSn",
			"type": "arrow",
			"fromId": "shape:0kM5k3DNKSV385erNmzCh",
			"toId": "shape:gYJWajxbOk_vG3QdtVL03",
			"props": {
				"isPrecise": false,
				"isExact": false,
				"normalizedAnchor": {
					"x": 0.5,
					"y": 0.5
				},
